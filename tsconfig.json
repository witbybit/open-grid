{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": ".",
		"paths": {
			"@open-grid/core": ["packages/core/src/index.ts"],
			"@open-grid/core/internal": ["packages/core/src/internal.ts"],
			"@open-grid/core/next": ["packages/core/src/next.ts"],
			"@open-grid/core/experimental": ["packages/core/src/experimental.ts"],
			"@open-grid/react": ["packages/react/src/index.ts"],
			"@open-grid/react/experimental": ["packages/react/src/experimental.ts"]
		},
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedModules": true,
		"jsx": "react-jsx"
	},
	"exclude": ["node_modules", "dist"]
}
