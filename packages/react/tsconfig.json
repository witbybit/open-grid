{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"baseUrl": "../..",
		"paths": {
			"@open-grid/core": ["packages/core/dist/index"],
			"@open-grid/core/internal": ["packages/core/dist/internal"]
		},
		"jsx": "react-jsx",
		"sourceMap": false,
		"declarationMap": false
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "dist", "node_modules"]
}
